# ==============================================================================
# SIH Problem Statement 26077 — Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate your local credentials if desired.
# NOTE: The system is designed to run 100% locally out-of-the-box in simulated
# benchmark mode without requiring any credentials or paid accounts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ISRO MOSDAC Satellite Ingestion (Free Registration)
# Portal: https://www.mosdac.gov.in
# Used for: INSAT-3D / INSAT-3DR TIR1, TIR2, and Water Vapor radiance downloads
# ------------------------------------------------------------------------------
MOSDAC_USERNAME=your_mosdac_username_or_email
MOSDAC_PASSWORD=your_mosdac_account_password

# ------------------------------------------------------------------------------
# 2. Copernicus Climate Data Store (CDS) API — ERA5 Reanalysis Fallback (Free)
# Portal: https://cds.climate.copernicus.eu
# Used for: Atmospheric temperature, humidity, geopotential, and wind profiles
# Alternatively saved in ~/.cdsapirc:
#   url: https://cds.climate.copernicus.eu/api
#   key: <CDS_API_KEY>
# ------------------------------------------------------------------------------
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=your_copernicus_personal_access_token

# ------------------------------------------------------------------------------
# 3. Optional Free-Tier Email Alert Dispatcher (Python standard library smtplib)
# Compatible with free email providers (e.g. Gmail with a 16-character App Password)
# NOTE: If left blank, the system automatically runs in Simulated Demo Mode,
# logging dispatches to data/processed/alerts/email_dispatch_log.json.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_SENDER=nowcast-alerts@open-earth.in

# ------------------------------------------------------------------------------
# 4. API & Application Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_SERVER_PORT=8501
ENVIRONMENT=development
LOG_LEVEL=INFO
